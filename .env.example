# Contact form (api/contact.js). Set these in Vercel → Project → Settings → Environment Variables,
# or in .env.local to test locally with `npm run dev`.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Programming Worlds <hello@your-domain.com>".
# Without a verified domain Resend only delivers to the email address that owns the Resend account.
CONTACT_FROM=
# Optional: defaults to programmingworld2030@gmail.com
CONTACT_TO=
